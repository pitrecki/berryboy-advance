  "finding": "Atomic BusTiming.refill advances both accesses without DMA arbitration. CPU retires all 24 ready cases before DMA completes; NBA completes the burst before branch retirement.",
  "timing": {
    "iwram_target": "No DMA: 3 cycles in both. With two-word IWRAM DMA: NBA 9 at readiness 1/2; BerryBoy 3.",
    "arm_rom_target": "No DMA: 15 both. IWRAM DMA ready 1: NBA 21 versus 15; ready 2: NBA 23 versus 15. DMA between refill reads forces the second ROM read nonsequential.",
    "thumb_rom_target": "No DMA: 9 both. IWRAM DMA ready 1: NBA 15 versus 9; ready 2: NBA 17 versus 9."
  },
